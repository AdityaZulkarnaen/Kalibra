{
  "name": "kalibra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm demo",
    "generate-fixtures": "tsx scripts/generate-fixtures.ts",
    "ingest": "tsx apps/indexer/src/index.ts",
    "api": "tsx apps/api/src/index.ts",
    "record": "tsx scripts/record.ts",
    "web": "pnpm --filter @kalibra/web dev",
    "web:build": "pnpm --filter @kalibra/web build",
    "guard": "tsx apps/guard/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@kalibra/adapter-dreamdex": "workspace:*",
    "@kalibra/api": "workspace:*",
    "@kalibra/core": "workspace:*",
    "@kalibra/db": "workspace:*",
    "@kalibra/guard": "workspace:*",
    "@kalibra/indexer": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "packageManager": "pnpm@11.24.0"
}
