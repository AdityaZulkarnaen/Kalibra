# Kalibra configuration. See docs/ARCHITECTURE.md section 6.
# Every variable below is parsed at startup with Zod; a malformed value is a startup
# crash, never a silent default. Every variable below is also optional: with no
# configuration at all the repository runs offline against fixtures/, which is what
# CLAUDE.md invariant I3 rests on.
#
# Nothing loads this file automatically. There is no dotenv in the runtime path and the
# package.json scripts do not pass --env-file. Export these in your shell, or copy this
# file to .env and run a script as `node --env-file=.env ...`.

# --- indexer (pnpm ingest) --------------------------------------------------

# replay reads the committed fixtures and needs no network and no credentials.
KALIBRA_MODE=replay
KALIBRA_DB_PATH=./kalibra.db

# Required in live mode only, and there is no default: replay must never silently reach
# a network. The testnet value is verified in docs/DREAMDEX_ADAPTER.md section 7, U19,
# and its read surface is permissionless (U20) — no key, no wallet, no signature.
# DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Live mode reads orders per market to reconstruct mids, so this bounds one pass. 1..500.
DREAMDEX_MARKET_LIMIT=10

# --- api (pnpm api) ---------------------------------------------------------

API_PORT=3001

# --- guard (pnpm guard) -----------------------------------------------------

GUARD_PORT=3002
GUARD_POLICY_PATH=./guard.policy.json

# Not a credential from anywhere: generate one, for instance `openssl rand -hex 24`.
# Leave it unset and the operator routes are not registered at all — a kill switch that
# anyone reaching the port can flip is not a kill switch. Minimum 16 characters.
GUARD_OPERATOR_TOKEN=

# agentId=0xwallet pairs, comma separated. Guard fills are attributed to these wallets
# and scored on the same path as every other trade.
GUARD_AGENT_WALLETS=

# Guard forwards to the fixture adapter unless this is live. Live also needs
# DREAMDEX_INDEXER_URL above.
# KALIBRA_MODE=live

# The key Guard signs orders with, and the reason Guard is a risk envelope rather than a
# polite API: it lives in Guard's process and the agent never holds one. An agent with its
# own key calls the venue directly and every rule in the policy engine becomes advisory.
#
# Testnet only. Leave it unset and Guard still evaluates and logs every order, but the
# adapter refuses to write — the honest degradation, not a silent no-op.
# GUARD_SIGNER_KEY=

# Optional override. The SDK's Shannon definition already carries a WebSocket endpoint.
# SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# How long a resting order survives. Every binary order carries a mandatory expiry, and
# this is the dead-man's switch that ages a crashed agent's orders off the book.
GUARD_ORDER_TTL_MS=120000

# --- web (pnpm web) ---------------------------------------------------------

# Where apps/web reads the index from. It renders an error state when this is unreachable
# and never falls back to cached or placeholder data.
KALIBRA_API_URL=http://127.0.0.1:3001
