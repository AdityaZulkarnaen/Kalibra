# Kalibra configuration. See docs/ARCHITECTURE.md section 6.
# Every variable is parsed once at startup with Zod; a missing or malformed value is a
# startup crash, never a silent default.

# replay (default) runs entirely offline against fixtures/. See CLAUDE.md invariant I3.
KALIBRA_MODE=replay
KALIBRA_DB_PATH=./kalibra.db

# UNVERIFIED. See docs/DREAMDEX_ADAPTER.md section 7, unknowns U1 and U2.
# Leave blank until discovery resolves them; do not guess a URL.
DREAMDEX_REST_URL=
DREAMDEX_WS_URL=
DREAMDEX_API_KEY=

# Somnia testnet RPC. Testnet endpoint unconfirmed, see DREAMDEX_ADAPTER.md section 10.
SOMNIA_RPC_URL=

# Guard only. Never logged.
GUARD_WALLET_PRIVATE_KEY=

API_PORT=3001
WEB_PORT=3000
